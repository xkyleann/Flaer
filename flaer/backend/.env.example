# Database Configuration
DATABASE_URL=sqlite:///./flaer.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/flaer

# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# Stripe Configuration (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Optional: Email Service (SendGrid, Mailgun, etc.)
# SENDGRID_API_KEY=your_sendgrid_api_key
# EMAIL_FROM=noreply@flaer.io

# Optional: Monitoring & Error Tracking
# SENTRY_DSN=your_sentry_dsn

# Optional: Redis (for caching and rate limiting)
# REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
# ENVIRONMENT=production