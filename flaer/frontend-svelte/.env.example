# Public API address after backend deployment
VITE_API_URL=https://api.flaer.io

# Optional: Cal.com or Calendly event page. When present, the consultation
# section provides direct scheduling instead of the email request form.
VITE_BOOKING_URL=https://cal.com/your-team/consultation

# Create a public Mapbox token and restrict it to your production domains.
VITE_MAPBOX_TOKEN=pk.your_public_mapbox_token
